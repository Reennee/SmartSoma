# ─────────────────────────────────────────────────────────────────────────────
# SmartSoma Backend — Environment Variables
# Copy this file to .env and fill in real values.
#   cp backend/.env.example backend/.env
#
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite — zero config, auto-created on first run):
DATABASE_URL=sqlite:///./smartsoma.db

# Production (PostgreSQL on Railway — Railway sets this automatically):
# DATABASE_URL=postgresql://user:password@host:5432/smartsoma

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

ALGORITHM=HS256

# Token lifetime in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel URL):
# CORS_ORIGINS=http://localhost:3000,https://smartsoma.vercel.app

# ── ML Model ──────────────────────────────────────────────────────────────────
# Path to the pre-trained BiLSTM .pth file (relative to project root).
MODEL_PATH=./backend/models/bilstm_dkt_model.pth

# ── Environment ───────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
